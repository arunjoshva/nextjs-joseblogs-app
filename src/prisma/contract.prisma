// use prisma-8

model Blog {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  category  String
  imageUrl  String?
  readTime  String
  published Boolean  @default(false)
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())
}